# ==============================================================================
# Local Voice Gateway 环境配置示例模版
# 复制此文件为 .env 并在本地按需覆盖配置
# ==============================================================================

# 可选: 手动指定 Python 解释器路径 (如虚拟环境路径)
# PYTHON_EXEC=/path/to/your/venv/bin/python

# ==============================================================================
# 🎯 触发模式控制
# ==============================================================================
# 可选值:
# - hybrid: 混合模式 (听到唤醒词后激活，并识别说话人身份) - 推荐
# - wake_word: 仅关键词唤醒 (打游戏、看电影、多人嘈杂场景防误触)
# - voiceprint_passive: 纯声纹常开模式 (单兵沉浸书房，张嘴即触发)
TRIGGER_MODE=voiceprint_passive

# ==============================================================================
# 🔔 语音唤醒词配置 (OpenWakeWord)
# ==============================================================================
# 支持单独设置，也支持逗号分隔多词监听 (如: hey_jarvis,alexa)
# 本地模型列表: hey_jarvis, alexa, hey_mycroft, hey_rhasspy, timer, weather
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# ==============================================================================
# 🎙️ 声纹识别 (CAM++) 与硬件控制
# ==============================================================================
VOICEPRINT_THRESHOLD=0.50
AUDIO_DUPLEX_MODE=half
AUTO_SPEAK=true

# ==============================================================================
# 🎛️ VAD (人声活动检测) 动态能量阈值与录音配置
# ==============================================================================
# 初始人声能量触发门限
ENERGY_THRESHOLD=600
# 最低环境底噪校准门限
MIN_ENERGY_THRESHOLD=450
# 动态底噪倍数乘子
VAD_MULTIPLIER=1.5
# 说话停顿判停静默时长 (秒)
SILENCE_TIMEOUT=1.5
# 单次录音最长保护时限 (秒)
MAX_RECORD_SECONDS=30
# 说话起始点前向回溯缓冲包数 (保留开头微弱发音)
PRE_SPEECH_BUFFER=10

# ==============================================================================
# 🌐 网关网络服务与安全配置
# ==============================================================================
# 监听地址: 默认 127.0.0.1 (仅本机访问，安全收敛)
# 若在 Docker、虚拟机、局域网或远程反向代理场景下使用，请设置为 0.0.0.0
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
# 允许的跨域来源 (逗号分隔，默认允许所有)
CORS_ORIGINS=*

# ==============================================================================
# 📝 离线模型路径配置 (可选覆盖，默认位于 models/ 目录下)
# ==============================================================================
# FUNASR_MODEL_DIR=/path/to/your/models/funasr
# MOSS_MODEL_DIR=/path/to/your/models/moss_tts

# ==============================================================================
# 🤖 大模型对接 (留空或设为 echo 即为本地零配置复述回显模式)
# ==============================================================================
AGENT_API_URL=echo
AGENT_TOKEN=
